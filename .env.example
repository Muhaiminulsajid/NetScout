# ----- Core -----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# ----- Database / queues (defaults match docker-compose) -----
DATABASE_URL=postgresql+psycopg2://netscout:netscout@db:5432/netscout
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- External API keys (placeholders) -----
# The app runs without them: spam scoring falls back to SSL/domain-age/heuristics,
# and ImageTrace still does perceptual hashing + EXIF. Paste real keys to enable
# full functionality.
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY
GOOGLE_SAFE_BROWSING_API_KEY=YOUR_GOOGLE_SAFE_BROWSING_API_KEY
BING_VISUAL_SEARCH_API_KEY=YOUR_BING_VISUAL_SEARCH_API_KEY
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_CLOUD_VISION_API_KEY

# ----- Crawler & quotas -----
MAX_CRAWL_DEPTH=5
MAX_LINKS_PER_PAGE=40
CRAWLER_TIMEOUT_SECONDS=25
DAILY_CRAWL_QUOTA=50
DAILY_IMAGE_SEARCH_QUOTA=25
RATE_LIMIT_PER_MINUTE=30
